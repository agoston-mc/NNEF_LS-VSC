{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "NNEF",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#declarations"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#types"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#stdlib_functions"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#operators"
		}
	],
	"repository": {
		"comments": {
			"patterns": [{
				"name": "comment.line.number-sign.nnef",
				"match": "#.*$"
			}]
		},

		"strings": {
			"patterns": [{
				"name": "string.quoted.double.nnef",
				"begin": "\"",
				"end": "\"",
				"patterns": [
					{
						"name": "constant.character.escape.nnef",
						"match": "\\\\."
					}
				]
			},
			{
				"name": "string.quoted.single.nnef",
				"begin": "'",
				"end": "'",
				"patterns": [
					{
						"name": "constant.character.escape.nnef",
						"match": "\\\\."
					}
				]
			}]
		},

		"numbers": {
			"patterns": [{
					"name": "constant.numeric.nnef",
					"match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
				}]
		},

		"declarations": {
			"patterns": [{
				"captures": {
					"1": { "name": "storage.type.function.nnef" },
					"2": { "name": "entity.name.function.nnef" }
				},
				"match": "\\b(fragment|graph)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b"
			}]
		},

		"keywords": {
			"patterns": [{
				"name": "keyword.control.nnef",
				"match": "\\b(version|extension|for|in|if|else|yield)\\b"
			},
			{
				"name": "keyword.operator.word.nnef",
				"match": "\\b(length_of|shape_of|range_of)\\b"
			}]
		},

		"types": {
			"patterns": [{
				"name": "storage.type.nnef",
				"match": "\\b(tensor|integer|scalar|logical|string)\\b"
			}]
		},

		"constants": {
			"patterns": [{
				"name": "constant.language.boolean.nnef",
				"match": "\\b(true|false)\\b"
			}]
		},

		"stdlib_functions": {
			"patterns": [{
				"name": "support.function.builtin.nnef",
  				"match": "\\b(external|variable|constant|update|reshape|transpose|concat|split|slice|squeeze|unsqueeze|stack|unstack|tile|pad|gather|cast|add|sub|mul|div|pow|exp|log|sin|cos|tan|sinh|cosh|tanh|asin|acos|atan|asinh|acosh|atanh|abs|sign|rcp|neg|copy|lt|gt|le|ge|eq|ne|and|or|not|floor|ceil|round|select|sqr|sqrt|rsqr|rsqrt|log2|min|max|clamp|matmul|conv|deconv|box|debox|argmax_pool|sample|desample|nearest_downsample|area_downsample|nearest_upsample|multilinear_upsample|sum_reduce|max_reduce|min_reduce|argmax_reduce|argmin_reduce|any_reduce|all_reduce|mean_reduce|moments|relu|sigmoid|softabs|softmax|softplus|elu|selu|gelu|silu|prelu|leaky_relu|max_pool_with_index|max_pool|avg_pool|rms_pool|linear|separable_conv|separable_deconv|local_response_normalization|local_mean_normalization|local_variance_normalization|local_contrast_normalization|l1_normalization|l2_normalization|batch_normalization|avg_roi_pool|max_roi_pool|roi_resample|avg_roi_align|max_roi_align|min_max_linear_quantize|zero_point_linear_quantize|linear_quantize|logarithmic_quantize|copy_n|add_n)(?=\\s*[<({])"
			},
			{
				"name": "entity.name.function.call.nnef",
				"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*[<(])"
			}]
		},

		"variables": {
			"patterns": [
				{
					"name": "variable.parameter.nnef",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*:)"
				},
				{
					"name": "variable.parameter.nnef",
					"match": "(?<=[(,]\\s*)\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*=(?!=))"
				},
				{
					"name": "variable.other.nnef",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
				}
			]
		},

		"operators": {
			"patterns": [{
				"name": "keyword.operator.symbol.nnef",
				"match": "(->|&&|\\|\\||<=|>=|==|!=|[+\\-*/<>=!?:])"
			}]
		}

	},
	"scopeName": "source.nnef"
}