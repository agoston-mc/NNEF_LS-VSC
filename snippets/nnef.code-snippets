{
	"NNEF Version Header": {
		"prefix": "version",
		"body": [
			"version ${1:1.0};",
			"$0"
		],
		"description": "NNEF version header declaration"
	},
	"NNEF Extension Header": {
		"prefix": "extension",
		"body": [
			"extension ${1:KHR_enable_fragment_definitions};",
			"$0"
		],
		"description": "NNEF extension declaration"
	},
	"NNEF Graph Definition": {
		"prefix": "graph",
		"body": [
			"version 1.0;",
			"",
			"graph ${1:network}( ${2:input} ) -> ( ${3:output} )",
			"{",
			"\t${2:input} = external(shape = [${4:1, 3, 224, 224}]);",
			"\t$0",
			"}"
		],
		"description": "Define an NNEF 1.0 computation graph"
	},
	"NNEF Compound Fragment": {
		"prefix": "fragment",
		"body": [
			"fragment ${1:name}( ${2:input}: tensor<${3:scalar}> ) -> ( ${4:output}: tensor<${3:scalar}> )",
			"{",
			"\t$0",
			"}"
		],
		"description": "Define a compound NNEF fragment with a body"
	},
	"NNEF Fragment Prototype": {
		"prefix": "fragment_proto",
		"body": [
			"fragment ${1:name}<? = ${2:scalar}>( ${3:input}: tensor<?> ) -> ( ${4:output}: tensor<?> );"
		],
		"description": "Declare a generic NNEF fragment prototype"
	},
	"External Tensor": {
		"prefix": "external",
		"body": [
			"${1:input} = external<${2:scalar}>(shape = [${3:1, 3, 224, 224}]);"
		],
		"description": "Declare an external input tensor"
	},
	"Variable Tensor": {
		"prefix": "variable",
		"body": [
			"${1:weights} = variable<${2:scalar}>(shape = [${3:64, 3, 3, 3}], label = '${4:layer/weights}');"
		],
		"description": "Declare a learned variable tensor"
	},
	"Constant Tensor": {
		"prefix": "constant",
		"body": [
			"${1:const} = constant<${2:scalar}>(shape = [${3:1}], value = [${4:0.0}]);"
		],
		"description": "Declare a constant tensor"
	},
	"Convolution Layer": {
		"prefix": "conv",
		"body": [
			"${1:conv} = conv(${2:input}, ${3:filter}, ${4:bias}, padding = [${5:(0, 0), (0, 0)}], border = '${6:constant}', stride = [${7:1, 1}], dilation = [${8:1, 1}]);"
		],
		"description": "NNEF conv operation call"
	}
}
